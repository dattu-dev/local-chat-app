<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Chat Client"
        Height="600"
        Width="850"
        Background="#F4F7FB"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#4F8CFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#D6DCE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                CornerRadius="15"
                Padding="15"
                Margin="0,0,0,15">

            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.15"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Chat Application"
                               Foreground="#1F2937"
                               FontSize="26"
                               FontWeight="Bold"/>

                    <TextBlock Text="Console Server + WPF Client"
                               Foreground="#6B7280"
                               FontSize="13"/>
                </StackPanel>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="1"
                           Text="Offline"
                           Foreground="#EF4444"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           FontSize="15"/>
            </Grid>
        </Border>

        <!-- Main Area -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                CornerRadius="15"
                Padding="15"
                Margin="0,0,0,15">

            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Username + Server IP + Connect -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,15">

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Username"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="UsernameTextBox"
                                 Width="150"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Server IP"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="ServerIpTextBox"
                                 Width="150"
                                 Text="127.0.0.1"/>
                    </StackPanel>

                    <Button Content="Connect"
                            Width="110"
                            Height="42"
                            VerticalAlignment="Bottom"
                            Click="ConnectButton_Click"/>
                </StackPanel>

                <!-- Chat Box -->
                <Border Grid.Row="1"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10">

                    <ListBox x:Name="ChatListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#111827"
                             FontSize="16"
                             FontFamily="Segoe UI Emoji"/>
                </Border>
            </Grid>
        </Border>

        <!-- Emoji Area -->
        <Border Grid.Row="2"
                Background="#FFFFFF"
                CornerRadius="15"
                Padding="10"
                Margin="0,0,0,15">

            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.10"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Text="Emoji:"
                           Foreground="#374151"
                           VerticalAlignment="Top"
                           FontWeight="SemiBold"
                           Margin="0,8,12,0"/>

                <ScrollViewer Grid.Column="1"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">

                    <WrapPanel>
                        <Button Content="😀" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="😃" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="😄" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="😁" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="😂" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="🤣" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="😊" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="😍" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="😘" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="😎" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>

                        <Button Content="👍" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="👎" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="👏" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="🙌" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="🙏" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="💪" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>

                        <Button Content="❤️" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="🧡" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="💛" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="💚" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="💙" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="💜" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>

                        <Button Content="🔥" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="✨" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="🎉" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="💯" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="💀" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="😭" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="😡" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="🤔" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="😴" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="🤡" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>

                        <Button Content="📌" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="📚" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="💻" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="🎮" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                        <Button Content="☕" FontFamily="Segoe UI Emoji" FontSize="20" Click="EmojiButton_Click"/>
                    </WrapPanel>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Message Input -->
        <Border Grid.Row="3"
                Background="#FFFFFF"
                CornerRadius="15"
                Padding="12">

            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="MessageTextBox"
                         Height="42"
                         FontSize="16"
                         FontFamily="Segoe UI Emoji"
                         VerticalContentAlignment="Center"
                         KeyDown="MessageTextBox_KeyDown"/>

                <Button Grid.Column="1"
                        Content="Send"
                        Width="100"
                        Height="42"
                        Click="SendButton_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>