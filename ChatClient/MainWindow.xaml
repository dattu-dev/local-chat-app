<Window x:Class="ChatClient.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
        xmlns:local="clr-namespace:ChatClient"
        Title="Chat Client"
        Height="600"
        Width="850"
        Background="#F4F7FB"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <local:StringToImageSourceConverter x:Key="StringToImageSourceConverter"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#4F8CFF"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="5"/>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#222222"/>
            <Setter Property="BorderBrush" Value="#D6DCE8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>
    </Window.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0"
                Background="#FFFFFF"
                CornerRadius="15"
                Padding="15"
                Margin="0,0,0,15">

            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.15"/>
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Chat App - Group 5"
                               Foreground="#1F2937"
                               FontSize="26"
                               FontWeight="Bold"/>

        
                </StackPanel>

                <TextBlock x:Name="StatusTextBlock"
                           Grid.Column="1"
                           Text="Offline"
                           Foreground="#EF4444"
                           FontWeight="Bold"
                           VerticalAlignment="Center"
                           FontSize="15"/>
            </Grid>
        </Border>

        <!-- Main Area -->
        <Border Grid.Row="1"
                Background="#FFFFFF"
                CornerRadius="15"
                Padding="15"
                Margin="0,0,0,15">

            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Username + Server IP + Connect -->
                <StackPanel Grid.Row="0"
                            Orientation="Horizontal"
                            Margin="0,0,0,15">

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Username"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"
                                   FontWeight="SemiBold"/>

                        <TextBox x:Name="UsernameTextBox"
                                 Width="150"/>
                    </StackPanel>

                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="Server IP"
                                   Foreground="#374151"
                                   Margin="0,0,0,5"
                                   FontWeight="SemiBold"/>
                        <TextBox x:Name="ServerIpTextBox"
                                 Width="150"
                                 Text="127.0.0.1"/>
                    </StackPanel>
                    <Button x:Name="ConnectButton"
                            Content="Connect"
                            Width="110"
                            Height="42"
                            VerticalAlignment="Bottom"
                            Click="ConnectButton_Click"/>
                    <Button x:Name="DisconnectButton"
                            Content="Disconnect"
                            Width="110"
                            Height="42"
                            Background="#EF4444"
                            IsEnabled="False"
                            VerticalAlignment="Bottom"
                            Click="DisconnectButton_Click"/>
                </StackPanel>

                <!-- Chat Box -->
                <Border Grid.Row="1"
                        Background="#F9FAFB"
                        BorderBrush="#E5E7EB"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="10">

                    <ListBox x:Name="ChatListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             Foreground="#111827"
                             FontSize="16"
                             FontFamily="Segoe UI Emoji"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{Binding BackgroundColor}"
                                        Padding="10,8"
                                        Margin="0,5"
                                        CornerRadius="12"
                                        HorizontalAlignment="{Binding Alignment}"
                                        MaxWidth="400">
                                    <StackPanel>
                                        <emoji:TextBlock Text="{Binding Text}" 
                                                   Foreground="{Binding TextColor}"
                                                   TextWrapping="Wrap"
                                                   Visibility="{Binding HasText, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Image Source="{Binding ImageSource, Converter={StaticResource StringToImageSourceConverter}}" 
                                               MaxWidth="300" 
                                               MaxHeight="300" 
                                               Margin="0,5,0,0"
                                               Cursor="Hand"
                                               MouseLeftButtonDown="Image_MouseLeftButtonDown"
                                               Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}" />
                                        <Button Content="{Binding FileName}"
                                                Tag="{Binding FilePath}"
                                                Click="FileDownload_Click"
                                                Margin="0,5,0,0"
                                                Padding="10,5"
                                                Background="#E5E7EB"
                                                Foreground="#1F2937"
                                                BorderThickness="1"
                                                BorderBrush="#D1D5DB"
                                                Cursor="Hand"
                                                Visibility="{Binding HasFile, Converter={StaticResource BooleanToVisibilityConverter}}" />

                                        <!-- Transfer Progress UI -->
                                        <Grid Margin="0,5,0,0" Visibility="{Binding IsTransferring, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="📄" FontSize="32" Margin="0,0,10,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding FileName}" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="250" />
                                                <Grid Margin="0,5,0,0">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ProgressBar Grid.Column="0" Height="8" Minimum="0" Maximum="100" Value="{Binding ProgressPercentage}" VerticalAlignment="Center" Foreground="#4F8CFF" />
                                                    <TextBlock Grid.Column="1" Text="{Binding ProgressText}" FontSize="11" Foreground="Gray" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>
        </Border>

        <!-- Message Input -->
        <Border Grid.Row="3"
                Background="#FFFFFF"
                CornerRadius="15"
                Padding="12">

            <Border.Effect>
                <DropShadowEffect BlurRadius="10"
                                  ShadowDepth="2"
                                  Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <ItemsControl x:Name="PendingAttachmentsControl" Grid.Row="0" Margin="0,0,0,5" Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,10,10" CornerRadius="8" BorderThickness="1" BorderBrush="#D6DCE8" Background="#F9FAFB" Padding="4">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Image Source="{Binding DisplayIcon}" Width="60" Height="60" Stretch="UniformToFill" />
                                    </StackPanel>
                                    <StackPanel Orientation="Vertical" Width="60" Height="60" Background="#E5E7EB" Visibility="{Binding IsImage, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverted}">
                                        <TextBlock Text="📄" FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding FileName}" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" HorizontalAlignment="Center" ToolTip="{Binding FileName}" Margin="2,0"/>
                                    </StackPanel>
                                    <Button Content="✕" 
                                            Click="RemovePendingAttachment_Click" 
                                            Tag="{Binding}"
                                            HorizontalAlignment="Right" 
                                            VerticalAlignment="Top" 
                                            Margin="0,-5,-5,0"
                                            Width="20" Height="20"
                                            Background="#EF4444"
                                            Foreground="White"
                                            FontSize="10"
                                            Cursor="Hand"
                                            Padding="0"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <emoji:RichTextBox x:Name="MessageTextBox"
                             Height="42"
                             FontSize="16"
                             Background="White"
                             Foreground="#222222"
                             BorderBrush="#D6DCE8"
                             BorderThickness="1"
                             Padding="8"
                             VerticalContentAlignment="Center"
                             KeyDown="MessageTextBox_KeyDown"/>

                <Button Grid.Column="1"
                        Content="➕"
                        FontFamily="Segoe UI Emoji"
                        FontSize="20"
                        Width="42"
                        Height="42"
                        Margin="5,0,0,0"
                        Padding="0"
                        Background="Transparent"
                        Foreground="#374151"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Attach File"
                        Click="FileButton_Click"/>

                <Button Grid.Column="2"
                        Content="📷"
                        FontFamily="Segoe UI Emoji"
                        FontSize="20"
                        Width="42"
                        Height="42"
                        Margin="0,0,0,0"
                        Padding="0"
                        Background="Transparent"
                        Foreground="#374151"
                        BorderThickness="0"
                        Cursor="Hand"
                        ToolTip="Upload Image"
                        Click="ImageButton_Click"/>

                <ToggleButton x:Name="EmojiToggleButton"
                              Grid.Column="3"
                              Width="42"
                              Height="42"
                              Margin="5,0,5,0"
                              Padding="0"
                              Background="Transparent"
                              BorderThickness="0"
                              Cursor="Hand"
                              ToolTip="Emoji">
                    <emoji:TextBlock Text="😀" FontSize="20"/>
                </ToggleButton>

                <Popup IsOpen="{Binding IsChecked, ElementName=EmojiToggleButton}"
                       StaysOpen="False"
                       PlacementTarget="{Binding ElementName=EmojiToggleButton}"
                       Placement="Top"
                       AllowsTransparency="True">
                    <Border Background="#FFFFFF"
                            CornerRadius="10"
                            Padding="10"
                            Margin="0,0,0,10"
                            BorderBrush="#D6DCE8"
                            BorderThickness="1"
                            MaxHeight="200"
                            Width="250">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.15"/>
                        </Border.Effect>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <WrapPanel>
                                <Button Tag="😀" Click="EmojiButton_Click"><emoji:TextBlock Text="😀" FontSize="20"/></Button>
                                <Button Tag="😃" Click="EmojiButton_Click"><emoji:TextBlock Text="😃" FontSize="20"/></Button>
                                <Button Tag="😄" Click="EmojiButton_Click"><emoji:TextBlock Text="😄" FontSize="20"/></Button>
                                <Button Tag="😁" Click="EmojiButton_Click"><emoji:TextBlock Text="😁" FontSize="20"/></Button>
                                <Button Tag="😂" Click="EmojiButton_Click"><emoji:TextBlock Text="😂" FontSize="20"/></Button>
                                <Button Tag="🤣" Click="EmojiButton_Click"><emoji:TextBlock Text="🤣" FontSize="20"/></Button>
                                <Button Tag="😊" Click="EmojiButton_Click"><emoji:TextBlock Text="😊" FontSize="20"/></Button>
                                <Button Tag="😍" Click="EmojiButton_Click"><emoji:TextBlock Text="😍" FontSize="20"/></Button>
                                <Button Tag="😘" Click="EmojiButton_Click"><emoji:TextBlock Text="😘" FontSize="20"/></Button>
                                <Button Tag="😎" Click="EmojiButton_Click"><emoji:TextBlock Text="😎" FontSize="20"/></Button>

                                <Button Tag="👍" Click="EmojiButton_Click"><emoji:TextBlock Text="👍" FontSize="20"/></Button>
                                <Button Tag="👎" Click="EmojiButton_Click"><emoji:TextBlock Text="👎" FontSize="20"/></Button>
                                <Button Tag="👏" Click="EmojiButton_Click"><emoji:TextBlock Text="👏" FontSize="20"/></Button>
                                <Button Tag="🙌" Click="EmojiButton_Click"><emoji:TextBlock Text="🙌" FontSize="20"/></Button>
                                <Button Tag="🙏" Click="EmojiButton_Click"><emoji:TextBlock Text="🙏" FontSize="20"/></Button>
                                <Button Tag="💪" Click="EmojiButton_Click"><emoji:TextBlock Text="💪" FontSize="20"/></Button>

                                <Button Tag="❤️" Click="EmojiButton_Click"><emoji:TextBlock Text="❤️" FontSize="20"/></Button>
                                <Button Tag="🧡" Click="EmojiButton_Click"><emoji:TextBlock Text="🧡" FontSize="20"/></Button>
                                <Button Tag="💛" Click="EmojiButton_Click"><emoji:TextBlock Text="💛" FontSize="20"/></Button>
                                <Button Tag="💚" Click="EmojiButton_Click"><emoji:TextBlock Text="💚" FontSize="20"/></Button>
                                <Button Tag="💙" Click="EmojiButton_Click"><emoji:TextBlock Text="💙" FontSize="20"/></Button>
                                <Button Tag="💜" Click="EmojiButton_Click"><emoji:TextBlock Text="💜" FontSize="20"/></Button>

                                <Button Tag="🔥" Click="EmojiButton_Click"><emoji:TextBlock Text="🔥" FontSize="20"/></Button>
                                <Button Tag="✨" Click="EmojiButton_Click"><emoji:TextBlock Text="✨" FontSize="20"/></Button>
                                <Button Tag="🎉" Click="EmojiButton_Click"><emoji:TextBlock Text="🎉" FontSize="20"/></Button>
                                <Button Tag="💯" Click="EmojiButton_Click"><emoji:TextBlock Text="💯" FontSize="20"/></Button>
                                <Button Tag="💀" Click="EmojiButton_Click"><emoji:TextBlock Text="💀" FontSize="20"/></Button>
                                <Button Tag="😭" Click="EmojiButton_Click"><emoji:TextBlock Text="😭" FontSize="20"/></Button>
                                <Button Tag="😡" Click="EmojiButton_Click"><emoji:TextBlock Text="😡" FontSize="20"/></Button>
                                <Button Tag="🤔" Click="EmojiButton_Click"><emoji:TextBlock Text="🤔" FontSize="20"/></Button>
                                <Button Tag="😴" Click="EmojiButton_Click"><emoji:TextBlock Text="😴" FontSize="20"/></Button>
                                <Button Tag="🤡" Click="EmojiButton_Click"><emoji:TextBlock Text="🤡" FontSize="20"/></Button>

                                <Button Tag="📌" Click="EmojiButton_Click"><emoji:TextBlock Text="📌" FontSize="20"/></Button>
                                <Button Tag="📚" Click="EmojiButton_Click"><emoji:TextBlock Text="📚" FontSize="20"/></Button>
                                <Button Tag="💻" Click="EmojiButton_Click"><emoji:TextBlock Text="💻" FontSize="20"/></Button>
                                <Button Tag="🎮" Click="EmojiButton_Click"><emoji:TextBlock Text="🎮" FontSize="20"/></Button>
                                <Button Tag="☕" Click="EmojiButton_Click"><emoji:TextBlock Text="☕" FontSize="20"/></Button>
                            </WrapPanel>
                        </ScrollViewer>
                    </Border>
                </Popup>

                <Button Grid.Column="4"
                        Content="Send"
                        Width="100"
                        Height="42"
                        Click="SendButton_Click"/>
                        </Grid>
                    </Grid>
                </Border>

        <!-- Fullscreen Image Overlay -->
        <Grid x:Name="ImageOverlay"
              Grid.RowSpan="4"
              Background="#CC000000"
              Visibility="Collapsed"
              MouseLeftButtonDown="ImageOverlay_MouseLeftButtonDown">
            <Image x:Name="FullscreenImage"
                   Margin="40"
                   Stretch="Uniform"/>
            <Button Content="✕"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="20"
                    Width="40" Height="40"
                    Background="Transparent"
                    Foreground="White"
                    FontSize="24"
                    BorderThickness="0"
                    Cursor="Hand"
                    Click="CloseOverlay_Click"/>
        </Grid>
    </Grid>
</Window>